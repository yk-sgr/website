# Read at build time to render the contribution graph on the home page.
# Both are optional: a missing source is skipped, the graph shows what it can.

# GitHub personal access token, classic or fine-grained, `read:user` is enough.
# Locally this can be omitted; the build falls back to `gh auth token`.
GITHUB_TOKEN=

# GitLab personal access token from https://git.cloo-gmbh.de, scope `read_api`.
GITLAB_TOKEN=

# Override only if the GitLab instance moves.
# GITLAB_HOST=https://git.cloo-gmbh.de
