---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { LINKS, SITE } from '../consts';
import { external } from '../lib/external';
import { PROJECTS } from '../data/projects';
import { getContributions } from '../lib/contributions';

const all = await getCollection('posts', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const posts = all
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

const projects = PROJECTS.slice(0, 3);
const contributions = await getContributions();
const hasContributions = contributions.total > 0;
---

<BaseLayout>
  <header class="masthead">
    <h1>{SITE.title}</h1>
    <p class="lede">
      I build software and run <a href="https://cloo-gmbh.de" target="_blank" rel="noopener noreferrer">Cloo GmbH</a>{' '}
      from Germany. This is where I write down what I&rsquo;m learning along the
      way: the technical details, the company decisions, and everything in
      between.
    </p>
    <ul class="links">
      {
        LINKS.map((link) => (
          <li>
            <a href={link.href} {...external(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </header>

  {
    hasContributions && (
      <section class="section">
        <ContributionGraph data={contributions} />
      </section>
    )
  }

  <section class="section">
    <h2>writing</h2>
    <PostList posts={posts} />
    {all.length > posts.length && <a class="more" href="/blog/">all posts</a>}
  </section>

  <section class="section">
    <h2>projects</h2>
    <ProjectList projects={projects} />
    {PROJECTS.length > projects.length && <a class="more" href="/projects/">all projects</a>}
  </section>
</BaseLayout>
